[Unit]
Description=Sentinel Relogin independent single-account login UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sentinel
Group=sentinel
WorkingDirectory=/opt/sentinel-relogin
UMask=0077
ExecStart=/opt/sentinel-relogin/start
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sentinel-relogin /var/lib/sentinel-rs
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=192M
TasksMax=64

[Install]
WantedBy=multi-user.target
