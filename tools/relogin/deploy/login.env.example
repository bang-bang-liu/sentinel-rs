# Independent relogin configuration. No registration .env is loaded.
LOGIN_DB_PATH=/var/lib/sentinel-rs/sentinel-rs.db
LOGIN_LISTEN=127.0.0.1:8788
LOGIN_PROXY=
LOGIN_MAIL_MAP_FILE=/var/lib/sentinel-relogin/mail-map.json
LOGIN_MAIL_API_TOKEN=
LOGIN_MAIL_RESOLVE_URL=
LOGIN_MAIL_RESOLVE_TOKEN=
LOGIN_OTP_MAX_WAIT=180
LOGIN_OTP_POLL_INTERVAL=3
LOGIN_ADMIN_TOKEN_FILE=/var/lib/sentinel-relogin/admin.token
LOGIN_LOG=info
